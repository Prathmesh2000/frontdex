  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "frontdex",
    "react",
    "nextjs",
    "catalogue",
    "components",
    "documentation",
    "openapi",
    "storybook-alternative",
    "mcp",
    "ai-agents",
    "cursor",
    "claude-code",
    "knowledge-base"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@babel/traverse": "^7.29.10",
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prathmesh2000/frontdex.git"
  },
  "devDependencies": {
    "@astrojs/compiler": "^4.0.0",
    "svelte": "^5.57.2",
    "vue": "^3.5.44"
  }
}
