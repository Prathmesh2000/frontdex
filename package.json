{
  "name": "frontdex",
  "version": "0.3.0",
  "description": "A living index of your frontend: components, pages, state, APIs and health for developers and coding agents. React and Next.js today.",
  "type": "module",
  "bin": {
    "frontdex": "bin/frontdex.js",
    "fdx": "bin/frontdex.js",
    "rcat": "bin/frontdex.js",
    "react-catalogue": "bin/frontdex.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./next": "./src/plugins/next.cjs",
    "./vite": "./src/plugins/vite.js",
    "./query": "./src/query.cjs",
    "./schema.json": "./spec/catalogue.schema.json"
  },
  "files": [
    "bin",
    "src",
    "ui",
    "spec",
    "docs"
  ],
  "scripts": {
