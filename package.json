{
  "name": "react-catalogue",
  "version": "0.2.0",
  "description": "Knowledge base for React and Next.js frontends: components, pages, state, lifecycle, history, and a separate view for coding agents (MCP, rules, hooks).",
  "type": "module",
  "bin": {
    "rcat": "bin/rcat.js",
    "react-catalogue": "bin/rcat.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./next": "./src/plugins/next.cjs",
    "./vite": "./src/plugins/vite.js",
    "./query": "./src/query.cjs",
    "./schema.json": "./spec/catalogue.schema.json"
  },
  "files": [
    "bin",
    "src",
    "ui",
    "spec",
    "docs"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "react",
    "nextjs",
    "catalogue",
    "components",
    "documentation",
    "openapi",
    "storybook-alternative",
    "mcp",
    "ai-agents",
    "cursor",
    "claude-code",
    "knowledge-base"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@babel/traverse": "^7.29.10",
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  }
}
